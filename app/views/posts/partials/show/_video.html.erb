<%
  sources = [
    { src: post.file_url_ext_for(CurrentUser.user, "webm"), type: "video/webm" },
    { src: post.file_url_ext_for(CurrentUser.user, "mp4"), type: "video/mp4" },
  ]
%>
<div
  id="video-player"
  data-sources="<%= sources.to_json %>"
  data-poster="<%= post.video_poster_url(CurrentUser.user) %>"
  data-video-class="<%= post.display_class_for(CurrentUser.user) %>"
  data-audio-tracks="<%= post.audio_tracks_for_api(CurrentUser.user).to_json %>"
></div>
