<%# locals: (forum_post:, show: true) -%>

<li class="forum-post-vote-block" style="<%= "display: none" unless show %>">
  <%= button_to(tag.i(class: "fa-regular fa-thumbs-up"), forum_post_votes_path(forum_post), method: :post, params: { score: 1 }, title: "Vote up", class: "forum-vote-up") %>

  <%= button_to(tag.i(class: "fa-regular fa-face-meh"), forum_post_votes_path(forum_post), method: :post, params: { score: 0 }, title: "Vote meh", class: "forum-vote-meh") %>

  <%= button_to(tag.i(class: "fa-regular fa-thumbs-down"), forum_post_votes_path(forum_post), method: :post, params: { score: -1 }, title: "Vote down", class: "forum-vote-down") %>
</li>
