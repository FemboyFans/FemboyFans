<h1>Bans</h1>

<%= render("search") %>

<%= table_for(@bans, class: "striped autofit") do |t| %>
  <% t.column("User") do |ban| %>
    <%= link_to_user(ban.user) %>
    <%= link_to("»", bans_path(search: search_params(ban).merge(user_name: ban.user.name))) %>
    <% if ban.is_deleted? %>
      (deleted)
    <% end %>
  <% end %>
  <% t.column("Creator") do |ban| %>
    <%= link_to_user(ban.creator) %>
    <%= link_to("»", bans_path(search: search_params(ban).merge(creator_name: ban.creator.name))) %>
  <% end %>
  <% t.column("Banned") do |ban| %>
    <%= time_ago_in_words_tagged(ban.created_at) %>
  <% end %>
  <% t.column("Duration") do |ban| %>
    <%= ban.humanized_duration %>
  <% end %>
  <% t.column("Expiration") do |ban| %>
    <%= ban.expire_days_tagged %>
  <% end %>
  <% t.column("Reason", td: { class: "col-expand dtext-container" }) do |ban| %>
    <%= format_text(ban.reason) %>
  <% end %>
  <% t.column(if: policy(Ban).any?(:update?, :delete?, :undelete?, :destroy?)) do |ban| %>
    <% if policy(ban).update? %>
      <%= link_to("Edit", edit_ban_path(ban)) %>
    <% end %>
    <% if ban.is_deleted? %>
      <% if policy(ban).undelete? %>
        | <%= link_to("Undelete", undelete_ban_path(ban), method: :put, data: { confirm: "Are you sure you want to undelete this ban?" }) %>
      <% end %>
    <% elsif policy(ban).delete? %>
      | <%= link_to("Delete", delete_ban_path(ban), method: :put, data: { confirm: "Are you sure you want to delete this ban?" }) %>
    <% end %>
    <% if policy(ban).destroy? %>
      | <%= link_to("Destroy", ban_path(ban), method: :delete, data: { confirm: "This will PERMANENTLY destroy this ban record. This cannot be undone. Are you sure?" }) %>
    <% end %>
  <% end %>
<% end %>

<%= numbered_paginator(@bans) %>

<%= render("secondary_links") %>

<% content_for(:page_title) do %>
  Bans
<% end %>
